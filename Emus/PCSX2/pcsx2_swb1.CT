          <Description>"Refresh Pointer Symbols"</Description>
          <LastState/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
local TeamPointer = GetAddressSafe("[eemem]+518388")
if TeamPointer == nil then return end
local TeamPointerVal = readInteger(TeamPointer)
TeamPointerResult = TeamPointerVal+GetAddress("[eemem]")

local PlayerPointer = TeamPointerResult+0x3C
local PlayerPointerVal = readInteger(PlayerPointer)
PlayerPointerResult = PlayerPointerVal+GetAddress("[eemem]")

{$asm}
[DISABLE]


